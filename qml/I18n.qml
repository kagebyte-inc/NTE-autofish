    function textFor(key) {
        var lang = catalog[language] ? language : "en"
        if (catalog[lang][key] !== undefined)
            return catalog[lang][key]
        if (catalog.en[key] !== undefined)
            return catalog.en[key]
        return key
    }

    function format(key, value) {
        return textFor(key).replace("%1", value)
    }

    function statusText(value) {
        var key = "status." + value
        return textFor(key) === key ? value.toUpperCase() : textFor(key)
    }

    function fishingEventText(value) {
        return value === catalog.en["placeholder.event"] ? textFor("placeholder.event") : value
    }

    function fishingLogText(value) {
        return value === catalog.en["placeholder.log"] ? textFor("placeholder.log") : value
    }

    function rawEventsText(value) {
        return value === catalog.en["placeholder.raw"] ? textFor("placeholder.raw") : value
    }
}
